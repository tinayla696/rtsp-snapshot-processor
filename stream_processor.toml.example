# Copy this file to stream_processor.toml and edit values for your environment.

rtsp_url = "rtp://192.168.11.122:5004"
snapshot_interval_sec = 60.0
save_dir = "./snapshots"
db_path = "./snapshot_records.db"
capture_backend = "rtp"
gstreamer_pipeline_template = 'uridecodebin uri="{url}" ! videoconvert ! appsink max-buffers=1 drop=true sync=false'
jpeg_quality = 95
reconnect_delay_sec = 1.0
notification_url = "http://localhost:8000/api/v1/snapshots/notify"
rtp_port = 5004
rtp_payload_type = 96
rtp_clock_rate = 90000
rtp_width = 1280
rtp_height = 720